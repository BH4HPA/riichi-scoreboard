{
  "name": "riichi-scoreboard",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "version": "2.0.0",
  "type": "module",
  "packageManager": "yarn@4.13.0",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "yarn workspaces foreach -Api --include 'apps/*' run dev",
    "build": "yarn workspaces foreach -At --include 'apps/*' run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "yarn workspaces foreach -Ap run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
