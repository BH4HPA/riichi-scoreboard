# 复制为 apps/server/.env（yarn dev 自动读取）或写入 docker compose 的环境变量。
# 全部留空即本地模式：SQLite 与头像文件都放在 DATA_DIR。

# ---- 前端构建期配置（VITE_*，yarn dev 从 apps/web/.env 读，docker compose 作为 build args 传入）----
# 静态桶里本项目的公共前缀：曲库 <前缀>/music/、识别模型 <前缀>/models/；留空即没有这两项功能
VITE_STATIC_BASE_URL=
# 站点公开地址（canonical / og:url）
VITE_SITE_URL=
# 页脚署名（可选）：名字、链接、起始年份
VITE_SITE_AUTHOR=
VITE_SITE_AUTHOR_URL=
VITE_SITE_SINCE=
# 备案号（可选，中国大陆站点）
VITE_ICP_NUMBER=

PORT=8787
DATA_DIR=./data
# 前端单独托管到 COS/CDN 时填其 origin，逗号分隔；同源部署留空
CORS_ORIGINS=
# 房间闲置多久后从内存卸载（毫秒）
ROOM_IDLE_MS=3600000
# 经反向代理/CDN 回源时设为 1：注册限流按 X-Forwarded-For 首项计 IP（直连部署留空）
TRUST_PROXY=

# 腾讯云 COS。五项核心变量要么全填要么全空，只填一部分会启动失败。
# 建议用 CAM 子账号，只授予 cos:PutObject / cos:DeleteObject 到 <bucket>/riichi/* 的权限。
QCLOUD_SECRET_ID=
QCLOUD_SECRET_KEY=
QCLOUD_COS_BUCKET=
# 如 ap-shanghai
QCLOUD_COS_REGION=
# 可选：加速端点，如 cos.accelerate.myqcloud.com
QCLOUD_COS_ENDPOINT=
# 公开访问域名（CDN），如 https://static.example.com
QCLOUD_COS_CDN_DOMAIN=
# 桶内前缀（与同桶的其它项目隔离）
COS_KEY_PREFIX=riichi/

# ---- 线上服务器（ci/deploy-server.sh）----
# 密钥、static 桶、镜像仓库登录从服务器的 ~/.env 继承；仓库目录下的 .env 只放这三项：
# RIICHI_IMAGE=<镜像仓库>/<namespace>/riichi
# RIICHI_PORT=8787
# CORS_ORIGINS=https://<前端域名>
# 前端在 COS，镜像不提供页面（留空 = 关闭静态托管，页面路径 302 到 CORS_ORIGINS 第一项）
# WEB_DIST=
